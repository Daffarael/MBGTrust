generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// TABEL 1: pengguna
// ============================================================
model Pengguna {
  id                   Int      @id @default(autoincrement())
  nikNisn              String?  @unique @map("nik_nisn")
  namaLengkap          String   @map("nama_lengkap")
  email                String?  @unique
  katasandi            String
  peran                Peran    @default(PENERIMA_MANFAAT)
  tingkatKelas         String?  @map("tingkat_kelas")
  riwayatAlergi        Json?    @map("riwayat_alergi")
  nomorKontak          String?  @map("nomor_kontak")
  poinXp               Int      @default(0) @map("poin_xp")
  dampakLingkunganGram Float    @default(0) @map("dampak_lingkungan_gram")
  idSekolah            Int?     @map("id_sekolah")
  dibuatPada           DateTime @default(now()) @map("dibuat_pada")
  diubahPada           DateTime @updatedAt @map("diubah_pada")

  sekolah       Sekolah?        @relation(fields: [idSekolah], references: [id])
  evaluasiMenu  EvaluasiMenu[]
  konfirmasi    Konfirmasi[]
  tokenPenyegar TokenPenyegar[]

  @@index([idSekolah])
  @@map("pengguna")
}

// ============================================================
// TABEL 2: token_penyegar
// ============================================================
model TokenPenyegar {
  id          Int      @id @default(autoincrement())
  idPengguna  Int      @map("id_pengguna")
  token       String   @unique @db.VarChar(512)
  kedaluwarsa DateTime @map("kedaluwarsa")
  dibuatPada  DateTime @default(now()) @map("dibuat_pada")

  pengguna Pengguna @relation(fields: [idPengguna], references: [id])

  @@index([idPengguna])
  @@map("token_penyegar")
}

// ============================================================
// TABEL 3: sekolah
// ============================================================
model Sekolah {
  id         Int      @id @default(autoincrement())
  nama       String
  alamat     String?
  dibuatPada DateTime @default(now()) @map("dibuat_pada")

  pengguna       Pengguna[]
  jadwalMenu     JadwalMenu[]
  eksekusiTopsis EksekusiTopsis[]

  @@map("sekolah")
}

// ============================================================
// TABEL 4: bahan_baku
// ============================================================
model BahanBaku {
  id             Int      @id @default(autoincrement())
  namaBahan      String   @map("nama_bahan")
  satuan         String
  kaloriPer100g  Float?   @map("kalori_per_100g")
  proteinPer100g Float?   @map("protein_per_100g")
  potensiAlergen Boolean  @default(false) @map("potensi_alergen")
  hargaPerSatuan Int?     @map("harga_per_satuan")
  dibuatPada     DateTime @default(now()) @map("dibuat_pada")
  diubahPada     DateTime @updatedAt @map("diubah_pada")

  menuBahanBaku MenuBahanBaku[]

  @@map("bahan_baku")
}

// ============================================================
// TABEL 5: menu
// ============================================================
model Menu {
  id                    Int          @id @default(autoincrement())
  namaMenu              String       @map("nama_menu")
  kategori              KategoriMenu @default(MAKANAN_BERAT)
  deskripsi             String?
  kaloriKkal            Float?       @map("kalori_kkal")
  proteinGram           Float?       @map("protein_gram")
  karbohidratGram       Float?       @map("karbohidrat_gram")
  lemakGram             Float?       @map("lemak_gram")
  komposisiBahan        Json?        @map("komposisi_bahan")
  potensiAlergen        Json?        @map("potensi_alergen")
  estimasiHargaPerPorsi Int?         @map("estimasi_biaya_per_porsi")
  gambarUrl             String?      @map("gambar_url")
  dibuatPada            DateTime     @default(now()) @map("dibuat_pada")
  diubahPada            DateTime     @updatedAt @map("diubah_pada")

  jadwalMenu    JadwalMenu[]
  menuBahanBaku MenuBahanBaku[]

  @@map("menu")
}

// ============================================================
// TABEL 6: menu_bahan_baku (Tabel Pivot Many-to-Many)
// ============================================================
model MenuBahanBaku {
  id           Int   @id @default(autoincrement())
  idMenu       Int   @map("id_menu")
  idBahanBaku  Int   @map("id_bahan_baku")
  porsiPerMenu Float @default(1.0) @map("porsi_per_menu")

  menu      Menu      @relation(fields: [idMenu], references: [id], onDelete: Cascade)
  bahanBaku BahanBaku @relation(fields: [idBahanBaku], references: [id], onDelete: Cascade)

  @@unique([idMenu, idBahanBaku])
  @@map("menu_bahan_baku")
}

// ============================================================
// TABEL 7: jadwal_menu
// ============================================================
model JadwalMenu {
  id               Int      @id @default(autoincrement())
  idMenu           Int      @map("id_menu")
  idSekolah        Int      @map("id_sekolah")
  tanggal          DateTime @db.Date
  targetTotalPorsi Int?     @map("target_total_porsi")
  dibuatPada       DateTime @default(now()) @map("dibuat_pada")

  menu            Menu             @relation(fields: [idMenu], references: [id])
  sekolah         Sekolah          @relation(fields: [idSekolah], references: [id])
  evaluasiMenu    EvaluasiMenu[]
  konfirmasi      Konfirmasi[]
  rencanaProduksi RencanaProduksi?
  produksi        Produksi?
  distribusi      Distribusi[]
  hasilNlp        HasilNlp[]

  @@unique([idSekolah, tanggal])
  @@index([tanggal])
  @@index([idMenu])
  @@map("jadwal_menu")
}

// ============================================================
// TABEL 8: evaluasi_menu
// C1, C2, C3, C4 (Semua Benefit)
// ============================================================
model EvaluasiMenu {
  id                   Int      @id @default(autoincrement())
  idPengguna           Int      @map("id_pengguna")
  idJadwal             Int      @map("id_jadwal")
  menerimaPorsi        Boolean? @map("menerima_porsi")
  penilaianRasa        Int?     @map("penilaian_rasa")          // C1 TOPSIS (Benefit)
  tingkatKesukaan      Int?     @map("tingkat_kesukaan")        // C2 TOPSIS (Benefit)
  kesesuaianPorsi      Int?     @map("kesesuaian_porsi")        // C3 TOPSIS (Benefit)
  persentaseDikonsumsi Float?   @map("persentase_dikonsumsi")   // C4 TOPSIS (Benefit)
  volumeSisaGram       Float?   @map("volume_sisa_gram")
  ulasanTeks           String?  @map("ulasan_teks")
  dibuatPada           DateTime @default(now()) @map("dibuat_pada")

  pengguna   Pengguna   @relation(fields: [idPengguna], references: [id])
  jadwalMenu JadwalMenu @relation(fields: [idJadwal], references: [id])
  hasilNlp   HasilNlp[]

  @@unique([idPengguna, idJadwal])
  @@index([idJadwal])
  @@map("evaluasi_menu")
}

// ============================================================
// TABEL 9: konfirmasi
// C5 TOPSIS (Tingkat Penerimaan MBG -> Benefit)
// ============================================================
model Konfirmasi {
  id                Int              @id @default(autoincrement())
  idPengguna        Int              @map("id_pengguna")
  idJadwal          Int              @map("id_jadwal")
  status            StatusKonfirmasi @default(BELUM_KONFIRMASI)
  idAlasanPenolakan Int?             @map("id_alasan_penolakan")
  catatanKhusus     String?          @map("catatan_khusus")
  dibuatPada        DateTime         @default(now()) @map("dibuat_pada")
  diubahPada        DateTime         @updatedAt @map("diubah_pada")

  pengguna        Pengguna         @relation(fields: [idPengguna], references: [id])
  jadwalMenu      JadwalMenu       @relation(fields: [idJadwal], references: [id])
  alasanPenolakan AlasanPenolakan? @relation(fields: [idAlasanPenolakan], references: [id])

  @@unique([idPengguna, idJadwal])
  @@index([idJadwal])
  @@index([status])
  @@map("konfirmasi")
}

// ============================================================
// TABEL 10: alasan_penolakan
// ============================================================
model AlasanPenolakan {
  id    Int    @id @default(autoincrement())
  kode  String @unique
  label String

  konfirmasi Konfirmasi[]

  @@map("alasan_penolakan")
}

// ============================================================
// TABEL 11: rencana_produksi
// Formula: CEIL(total_hadir × (1 + buffer_persentase / 100))
// ============================================================
model RencanaProduksi {
  id               Int      @id @default(autoincrement())
  idJadwal         Int      @unique @map("id_jadwal")
  estimasiPorsi    Int      @map("estimasi_porsi")
  totalHadir       Int      @map("total_hadir")
  totalTidakHadir  Int      @map("total_tidak_hadir")
  bufferPersentase Float    @default(5.0) @map("buffer_persentase")
  dibuatPada       DateTime @default(now()) @map("dibuat_pada")
  diubahPada       DateTime @updatedAt @map("diubah_pada")

  jadwalMenu JadwalMenu @relation(fields: [idJadwal], references: [id])

  @@map("rencana_produksi")
}

// ============================================================
// TABEL 12: produksi
// ============================================================
model Produksi {
  id            Int            @id @default(autoincrement())
  idJadwal      Int            @unique @map("id_jadwal")
  status        StatusProduksi @default(PERSIAPAN)
  jumlahDimasak Int?           @map("jumlah_dimasak")
  catatanDapur  String?        @map("catatan_dapur")
  dibuatPada    DateTime       @default(now()) @map("dibuat_pada")
  diubahPada    DateTime       @updatedAt @map("diubah_pada")

  jadwalMenu JadwalMenu @relation(fields: [idJadwal], references: [id])

  @@map("produksi")
}

// ============================================================
// TABEL 13: distribusi
// ============================================================
model Distribusi {
  id           Int              @id @default(autoincrement())
  idJadwal     Int              @map("id_jadwal")
  status       StatusDistribusi @default(DISIAPKAN)
  waktuTiba    DateTime?        @map("waktu_tiba")
  catatanKurir String?          @map("catatan_kurir")
  dibuatPada   DateTime         @default(now()) @map("dibuat_pada")
  diubahPada   DateTime         @updatedAt @map("diubah_pada")

  jadwalMenu JadwalMenu @relation(fields: [idJadwal], references: [id])

  @@index([idJadwal])
  @@map("distribusi")
}

// ============================================================
// TABEL 14: eksekusi_topsis
// ============================================================
model EksekusiTopsis {
  id              Int      @id @default(autoincrement())
  idSekolah       Int?     @map("id_sekolah")
  periodeAwal     DateTime @db.Date @map("periode_awal")
  periodeAkhir    DateTime @db.Date @map("periode_akhir")
  hasilJson       Json     @map("hasil_json")
  rekomendasiJson Json     @map("rekomendasi_json")
  dibuatPada      DateTime @default(now()) @map("dibuat_pada")

  sekolah Sekolah? @relation(fields: [idSekolah], references: [id])

  @@index([idSekolah])
  @@index([periodeAwal, periodeAkhir])
  @@map("eksekusi_topsis")
}

// ============================================================
// TABEL 15: hasil_nlp
// ============================================================
model HasilNlp {
  id           Int         @id @default(autoincrement())
  idEvaluasi   Int         @map("id_evaluasi")
  idJadwal     Int         @map("id_jadwal")
  sentimen     SentimenNlp
  kataKunci    Json?       @map("kata_kunci")
  skorSentimen Float?      @map("skor_sentimen")
  dibuatPada   DateTime    @default(now()) @map("dibuat_pada")

  evaluasiMenu EvaluasiMenu @relation(fields: [idEvaluasi], references: [id])
  jadwalMenu   JadwalMenu   @relation(fields: [idJadwal], references: [id])

  @@index([idJadwal])
  @@map("hasil_nlp")
}

// ============================================================
// ENUM
// ============================================================
enum Peran {
  SUPER_ADMIN
  SPPG_ADMIN
  PENERIMA_MANFAAT
}

enum KategoriMenu {
  MAKANAN_BERAT
  SNACK
  MINUMAN
}

enum StatusKonfirmasi {
  HADIR
  TIDAK_HADIR
  BELUM_KONFIRMASI
}

enum StatusProduksi {
  PERSIAPAN
  MEMASAK
  SELESAI
  DIBATALKAN
}

enum StatusDistribusi {
  DISIAPKAN
  DIKIRIM
  TIBA_DI_SEKOLAH
  GAGAL
}

enum SentimenNlp {
  POSITIF
  NEGATIF
  NETRAL
}
